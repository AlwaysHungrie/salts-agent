{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "salt-agent",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "dev": { "port": 8787 },
  // Served on its own domain; the workers.dev URL stays on so existing links keep
  // working (routes switch it off unless it is set).
  "routes": [{ "pattern": "api.salts.dev", "custom_domain": true }],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "SessionAgent", "class_name": "SessionAgent" },
      { "name": "SessionRegistry", "class_name": "SessionRegistry" },
      { "name": "AgentDirectory", "class_name": "AgentDirectory" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SessionAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["SessionRegistry"] },
    { "tag": "v3", "new_sqlite_classes": ["AgentDirectory"] }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "salt-agent-files" }
  ],

  // A second, entirely separate deployment to try a change on before it is the one
  // answering. Not a flag on production: a different Worker name, which means its own
  // Durable Object namespaces and therefore its own agents, sessions and SQLite. A
  // migration that goes wrong there goes wrong on staging's data and nobody else's.
  //
  //     npm run deploy:staging && npm run smoke:staging
  //
  // The R2 bucket is separate for the same reason — `wrangler r2 bucket create
  // salt-agent-files-staging` once, before the first staging deploy. Secrets are
  // per-environment too, so `wrangler secret put API_SECRET --env staging` (and any
  // other secret production holds) is also a one-time setup step.
  //
  // `vars` are not inherited by an environment, so CLERK_ISSUER is repeated here rather
  // than referenced. Staging signs in against the Clerk development instance, which
  // the preview deploys of the web app use (`pk_test`); production has its own.
  "env": {
    "staging": {
      "name": "salt-agent-staging",
      "observability": { "enabled": true },
      "routes": [{ "pattern": "api-staging.salts.dev", "custom_domain": true }],
      "workers_dev": true,
      "durable_objects": {
        "bindings": [
          { "name": "SessionAgent", "class_name": "SessionAgent" },
          { "name": "SessionRegistry", "class_name": "SessionRegistry" },
          { "name": "AgentDirectory", "class_name": "AgentDirectory" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["SessionAgent"] },
        { "tag": "v2", "new_sqlite_classes": ["SessionRegistry"] },
        { "tag": "v3", "new_sqlite_classes": ["AgentDirectory"] }
      ],
      "r2_buckets": [
        { "binding": "FILES", "bucket_name": "salt-agent-files-staging" }
      ],
      "vars": {
        "CLERK_ISSUER": "https://rich-horse-1284.clerk.accounts.dev",
        "APP_URL": "https://staging.salts.dev",
        "PAYMENT_RPC": {
          "ethereum": "https://ethereum-rpc.publicnode.com",
          "base": "https://base-rpc.publicnode.com",
          "arbitrum": "https://arbitrum-one-rpc.publicnode.com",
          "optimism": "https://optimism-rpc.publicnode.com",
          "polygon": "https://polygon-bor-rpc.publicnode.com",
          "solana": "https://api.mainnet-beta.solana.com",
          // Testnet: faucet coins buy real credit, so staging only.
          "base-sepolia": "https://base-sepolia-rpc.publicnode.com"
        }
      }
    }
  },
  "vars": {
    // The Clerk instance whose session tokens this Worker verifies, as the exact `iss`
    // those tokens carry. Not a secret — it is a public URL, and the key set under it
    // is public too — so it lives here rather than in `wrangler secret`. This is the
    // production instance; `wrangler dev` signs in against the development one, so
    // `.dev.vars` overrides it locally (see `.dev.vars.example`).
    "CLERK_ISSUER": "https://clerk.salts.dev",
    // The web app the `!docs`, `!settings` and `!mcp` links point at.
    "APP_URL": "https://app.salts.dev",
    // The JSON-RPC endpoint each payment network's transactions are read back from. Where
    // payments go is set from the admin CLI (`/api/admin/payment-addresses`), not here.
    // Ethereum's also serves the Chainlink ETH/USD price. A missing one switches it off.
    "PAYMENT_RPC": {
      "ethereum": "https://ethereum-rpc.publicnode.com",
      "base": "https://base-rpc.publicnode.com",
      "arbitrum": "https://arbitrum-one-rpc.publicnode.com",
      "optimism": "https://optimism-rpc.publicnode.com",
      "polygon": "https://polygon-bor-rpc.publicnode.com",
      "solana": "https://api.mainnet-beta.solana.com"
    }
  }
}
