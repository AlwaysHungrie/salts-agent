# Production deployment.
AGENT_URL=https://api.salts.dev
API_SECRET=

# Used instead when the CLI is run with --dev.
AGENT_URL_DEV=http://127.0.0.1:8787
API_SECRET_DEV=

# Used instead when the CLI is run with --staging. Its own Worker, so its own
# API_SECRET — whatever `wrangler secret put API_SECRET --env staging` was given.
AGENT_URL_STAGING=https://api-staging.salts.dev
API_SECRET_STAGING=
