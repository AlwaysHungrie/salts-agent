# Bearer-token gate in front of SearXNG. Only used with the `guarded` profile.
#
# The token itself lives in token.conf, which the `init` service generates on the
# first run. Importing it (rather than reading an env var) keeps the token out of
# this file and works on the very first `up`, when .env has not been read yet.
:8081 {
	import /etc/caddy/token.conf

	reverse_proxy searxng:8080
}
