# The agent Worker this app talks to (staging).
AGENT_URL=https://salt-agent-staging.dhairyashah98.workers.dev
AGENT_ID=acdab9e7
# A user API key for that agent: salt_user_<agentId>_<secret>. From the agent's settings.
AGENT_API_KEY=

# Local MongoDB.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=devcon-jobs-matchmaker

# Signs session JWTs. At least 32 random characters: `openssl rand -base64 48`.
SESSION_SECRET=

# OpenRouter key for the small model this app runs itself: reads candidate ids from the
# agent's replies and screens chat messages. Never commit a real key.
OPENROUTER_API_KEY=
