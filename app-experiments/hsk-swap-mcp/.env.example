# testnet (chain 133) | mainnet (chain 177). This server only reads; it never holds a key or sends a transaction.
HSK_NETWORK=testnet
# Optional overrides of the network's public endpoints.
# RPC_URL=https://testnet.hsk.xyz
# EXPLORER_API=https://testnet-explorer.hskchain.net/api/v2

# stdio | http. The agent connects over http.
MCP_TRANSPORT=http
MCP_HOST=127.0.0.1
MCP_PORT=8390
# Required for http: the agent sends `Authorization: Bearer <token>`. `openssl rand -hex 24`. Never commit a real one.
MCP_AUTH_TOKEN=
