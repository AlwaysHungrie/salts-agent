# Profiles are stored under this directory.
DATA_DIR=./data

# Pays for model calls when the caller sends no X-OpenRouter-Api-Key header. Never commit a real key.
OPENROUTER_API_KEY=
# What one person may cost that key, in US dollars per UTC day and month. 0 = no limit. A saved profile is about
# $0.001, a search about $0.00002.
PERSON_DAILY_LIMIT_USD=0.05
PERSON_MONTHLY_LIMIT_USD=0.50
LLM_MODEL=openai/gpt-5-nano
EMBED_MODEL=openai/text-embedding-3-small
EMBED_DIM=1536

# Required, at least 32 bytes: callers send secrets minted with it. The same value as devcon-humans'
# FIND_HUMANS_SIGNING_KEY (`openssl rand -base64 48`). Never commit a real key.
SECRET_SIGNING_KEY=

# stdio | http.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
