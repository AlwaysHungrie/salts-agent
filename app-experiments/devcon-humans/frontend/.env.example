# The salts Worker (staging).
AGENT_URL=https://salt-agent-staging.dhairyashah98.workers.dev

# The fleet's API key (Fleet Settings → Fleet API key). Each user's agent is found or added in that fleet by email.
FLEET_API_KEY=

# The find-humans MCP server (https, e.g. behind a tunnel) and the key it checks secrets with (its
# SECRET_SIGNING_KEY). Never commit a real key.
FIND_HUMANS_MCP_URL=
FIND_HUMANS_SIGNING_KEY=

# Local MongoDB.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=devcon-humans

# Signs session JWTs. At least 32 random characters: `openssl rand -base64 48`.
SESSION_SECRET=
