# The zingo-cli binary. Build it from https://github.com/zingolabs/zingolib (`makers run-cli --build-only`);
# nym-proxy must sit beside it, or an online session cannot start.
ZINGO_CLI_BIN=zingo-cli
# mainnet, testnet or regtest. Each network keeps its own wallet, so switching makes a new one.
ZINGO_CHAIN=mainnet
# The indexer to sync and send through. Left unset, zingo-cli picks one itself.
# Mainnet: https://zec.rocks:443   Testnet: https://testnet.zec.rocks:443
# ZINGO_SERVER=
# Where the wallet lives: DATA_DIR/wallets/<chain>. Keep it when you update the server.
DATA_DIR=./data
# The most one send_zcash call may move, in ZEC. The agent chooses what to send; this is the ceiling.
MAX_SEND_ZEC=1
# How long any one zingo-cli run may take. A send syncs, signs and transmits, so keep it generous.
ZINGO_TIMEOUT_SECONDS=600
