# Where uploads, projects and exports are kept (relative to where the server starts).
DATA_DIR=./data
# Folder the user drops files into for open_file(inbox_file=…). Default DATA_DIR/inbox.
# INBOX_DIR=
# Largest file accepted, in bytes.
MAX_FILE_BYTES=26214400
# Rows a query or sheet read returns at most.
MAX_ROWS=200
# run_python executes model-written Python on this machine. Off unless true.
ALLOW_PYTHON=false
PYTHON_TIMEOUT_SECONDS=60
