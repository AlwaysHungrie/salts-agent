DATABASE_URL=postgresql://recruiter:recruiter@localhost:5432/recruiter
# Original resume files are stored under this directory.
DATA_DIR=./data
# Bulk inbox: users drop PDFs here, the agent ingests them. Default DATA_DIR/inbox.
# INBOX_DIR=

# OpenRouter key for stdio. Used for resume extraction, JD parsing and rerank. Ignored over HTTP, where every
# client must send its own key in the X-OpenRouter-Api-Key header.
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-5-mini
LLM_API_KEY=
# Folder ingest transcription only (ingest_folder, scripts/bulk_ingest.py).
VISION_MODEL=google/gemini-3.1-flash-lite

# Usually the same OpenRouter key.
EMBED_PROVIDER=openrouter
EMBED_MODEL=openai/text-embedding-3-small
# Fixed at first migration; changing it needs a re-embed and a migration.
EMBED_DIM=1536
EMBED_API_KEY=

# stdio | http. MCP_AUTH_TOKEN is required for http.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_AUTH_TOKEN=change-me

RERANK_POOL_SIZE=50
RERANK_CONCURRENCY=10
# Reasoning effort for extraction/JD parsing, and for the 50 rerank calls (reasoning bills as output).
LLM_REASONING_EFFORT=low
RERANK_REASONING_EFFORT=minimal
# Candidates scoring below this are left out of match results.
MIN_MATCH_SCORE=35
# Slack on years parsed from the JD; explicit filters are exact.
YEARS_SLACK_BELOW=1
YEARS_SLACK_ABOVE=2
# Candidates within this many points of a cutoff are scored twice and averaged; 0 disables.
RERANK_BORDERLINE_MARGIN=8

# Optional spend caps in USD for stdio. Over HTTP, X-Cost-Approved-* headers are required instead.
# COST_APPROVED_RESUME_INGESTION=0.01
# COST_APPROVED_JOB_MATCH=0.10
# COST_APPROVED_SEARCH=0.001
# COST_APPROVED_FOLDER_INGESTION=5.00
